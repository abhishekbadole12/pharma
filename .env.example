# Flask
FLASK_ENV=development
SECRET_KEY=replace_this
JWT_SECRET=replace_jwt
JWT_REFRESH_SECRET=replace_refresh

# Mongo
MONGO_URI=mongodb://mongodb:27017/pharma_ecommerce

# Storage
STORAGE_PROVIDER=local # or s3
UPLOAD_DIR=uploads
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# ===========================================
# Pharma E-Commerce Environment Variables
# ===========================================

# MongoDB
MONGO_URI=mongodb://mongodb:27017/pharma_ecommerce

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin seed credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@pharmaecommerce.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Cookie settings
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=flask-secret-key-change-in-production

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Dhan Laxmi Pharma 
